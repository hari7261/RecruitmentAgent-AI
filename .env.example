# Environment Variables for AI Recruitment System
# Copy this file to .env and fill in the values

# Google Gemini
GEMINI_API_KEY=

# Gmail (enable 2FA and create an App Password)
EMAIL_SENDER=
EMAIL_APP_PASSWORD=
COMPANY_NAME=Your Company Name

# Zoom Server-to-Server OAuth App Credentials
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

# Optional: Default Role (ai_ml_engineer | frontend_engineer | backend_engineer)
DEFAULT_ROLE=ai_ml_engineer
